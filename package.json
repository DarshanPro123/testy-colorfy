{
  "name": "testy-colorfy",
  "version": "0.2.0",
  "description": "Fast, ultra-simple, colorful Node.js & TypeScript logger with automatic file path & line caller tracing.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/index.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "logger",
    "console",
    "colorful-logger",
    "trace",
    "caller-location",
    "filepath",
    "node-logger",
    "zero-dependencies",
    "typescript",
    "fast-logger"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarshanPro123/testy-colorfy.git"
  },
  "author": "Darshan Panchal",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DarshanPro123/testy-colorfy/issues"
  },
  "homepage": "https://github.com/DarshanPro123/testy-colorfy#readme",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist/**/*"
  ]
}
